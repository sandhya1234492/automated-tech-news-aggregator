# Copy this file to .env and add your own values.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tech_news

# Get a NewsAPI.org API key from https://newsapi.org/
NEWS_API_KEY=
NEWS_API_URL=https://newsapi.org/v2/everything

# The scheduler will run at this local time.
NEWS_SCHEDULE_HOUR=6
NEWS_SCHEDULE_MINUTE=0
